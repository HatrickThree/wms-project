# Supabase Connect -> Transaction pooler (runtime / Vercel).
# Replace the entire host, username and URL-encoded password with your project values.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Supabase Connect -> Session pooler (migrations; IPv4 compatible).
# A direct db.PROJECT_REF.supabase.co:5432 connection also works with IPv6.
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Warehouse Default Configuration
NEXT_PUBLIC_COMPANY_NAME="In-House Smart Warehouse"
NEXT_PUBLIC_DEFAULT_WAREHOUSE="WH-MAIN"
