generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum LocationType {
  RECEIVING   // จุดพักรับสินค้าเข้า
  STORAGE     // ชั้นวางจัดเก็บปกติ
  PICKING     // จุดหยิบสินค้า
  PACKING     // จุดแพ็คเตรียมส่ง
  QUARANTINE  // โซนสินค้าชำรุด / รอตรวจสอบเคลม (RMA)
}

enum SerialStatus {
  IN_STOCK    // อยู่ในคลังสินค้า (พร้อมใช้งาน/พร้อมขาย)
  ALLOCATED   // ถูกจองไว้สำหรับใบสั่งขาย/ใบเบิกแล้ว
  SHIPPED     // จ่ายออกจากคลัง/ส่งมอบให้ลูกค้าแล้ว
  RETURNED    // รับคืนจากลูกค้า (อยู่ระหว่างตรวจสอบ)
  DEFECTIVE   // ชำรุด/เสีย (ห้ามหยิบขาย)
}

enum MovementType {
  INBOUND_RECEIVE   // รับสินค้าเข้าคลัง
  PUTAWAY           // ย้ายจากจุดรับเข้าขึ้นชั้นวาง
  INTERNAL_TRANSFER // ย้ายข้ามชั้นวาง
  OUTBOUND_PICK     // หยิบจ่ายออกจากคลัง
  RETURN_IN         // รับสินค้าคืนเข้าคลัง
  ADJUSTMENT_PLUS   // ปรับเพิ่มสต็อกจากผลตรวจนับ
  ADJUSTMENT_MINUS  // ปรับลดสต็อกจากผลตรวจนับ
}

model Warehouse {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  locations Location[]
  createdAt DateTime   @default(now())
}

model Location {
  id          String             @id @default(cuid())
  warehouseId String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])
  barcode     String             @unique // เช่น A-01-01-01
  zone        String
  aisle       String
  rack        String
  level       String
  type        LocationType       @default(STORAGE)
  inventories InventoryBalance[]
  serialItems SerialItem[]
}

model Product {
  id          String             @id @default(cuid())
  sku         String             @unique
  barcode     String             @unique
  name        String
  category    String?
  baseUom     String             @default("PCS")
  minStock    Int                @default(0)
  trackSerial Boolean            @default(true)
  trackLot    Boolean            @default(false)
  inventories InventoryBalance[]
  serialItems SerialItem[]
  movements   StockLedger[]
  createdAt   DateTime           @default(now())
}

model InventoryBalance {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
  qtyOnHand    Int      @default(0)
  qtyAllocated Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([productId, locationId])
}

model SerialItem {
  id            String        @id @default(cuid())
  serialNumber  String        @unique
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  locationId    String?
  location      Location?     @relation(fields: [locationId], references: [id])
  status        SerialStatus  @default(IN_STOCK)
  lotNumber     String?
  inboundDocNo  String
  outboundDocNo String?
  receivedAt    DateTime      @default(now())
  shippedAt     DateTime?
  warrantyExp   DateTime?
  movements     StockLedger[]
  updatedAt     DateTime      @updatedAt

  @@index([productId, status])
  @@index([locationId])
}

model StockLedger {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  serialItemId   String?
  serialItem     SerialItem?  @relation(fields: [serialItemId], references: [id])
  fromLocationId String?
  toLocationId   String?
  qtyChange      Int
  movementType   MovementType
  referenceDoc   String
  performedBy    String
  note           String?
  createdAt      DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([serialItemId])
  @@index([referenceDoc])
}
